# Conecte ao Neon (Postgres serverless)
# Crie um projeto em https://console.neon.tech e copie a connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Segredo para assinar a sessão do admin (opcional; se ausente, usa DATABASE_URL)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
